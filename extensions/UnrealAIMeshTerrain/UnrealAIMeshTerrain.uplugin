{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1.0",
  "FriendlyName": "Unreal AI Mesh Terrain (Experimental)",
  "Description": "Experimental, UE 5.8+ only. RQL module for Unreal's experimental Mesh Terrain (Mesh Partition): query mesh terrains, their sections and modifiers, read the surface height and rebuild with a deterministic wait. An AI Game Developer (Unreal-MCP) extension: an IUnrealMcpRqlModule that agents use through rql-query / rql-mutate / rql-schema.",
  "Category": "AI",
  "CreatedBy": "Ivan Murzak",
  "CreatedByURL": "https://github.com/IvanMurzak/Unreal-MCP",
  "DocsURL": "https://github.com/IvanMurzak/Unreal-MCP/blob/main/docs/EXTENSIONS.md",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/IvanMurzak/Unreal-MCP/issues",
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "UnrealAIMeshTerrain",
      "Type": "Editor",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "UnrealMCP",
      "Enabled": true
    },
    {
      "Name": "MeshPartition",
      "Enabled": true
    },
    {
      "Name": "MeshTerrainMode",
      "Enabled": true
    }
  ]
}
