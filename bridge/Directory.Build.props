<Project>
  <!--
    TEMPORARY pre-release feed (see the "TEMPORARY PRE-RELEASE PIN" entries in src/com.IvanMurzak.Unreal.MCP.Bridge.csproj):
    bridge/prerelease-packages/ holds com.IvanMurzak.Rql 0.3.0-dev.2877579, packed from RQL main 2877579, and
    com.IvanMurzak.McpPlugin(.Common, .Server) 8.14.0-dev.e8985d5 from MCP-Plugin-dotnet main e8985d5. Every project
    under bridge/ (the sidecar and its tests) restores from it in addition to the configured sources.
    Delete this file and prerelease-packages/ when the pins move back to published nuget.org versions.
  -->
  <!-- Keep any Directory.Build.props above this folder in effect (MSBuild imports only the nearest one). -->
  <PropertyGroup>
    <_UnrealMcpParentBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_UnrealMcpParentBuildProps>
  </PropertyGroup>
  <Import Project="$(_UnrealMcpParentBuildProps)" Condition="'$(_UnrealMcpParentBuildProps)' != ''" />
  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)prerelease-packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
