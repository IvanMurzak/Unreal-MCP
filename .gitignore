# ----------------------------------------------------------------------------
# Unreal Engine (plugin build artifacts + any generated host-project artifacts)
# ----------------------------------------------------------------------------
Binaries/
Intermediate/
Saved/
DerivedDataCache/
.vs/
.vscode/
.idea/
*.sln
# The .NET sub-projects keep hand-authored solution files (UE only ever
# generates a .sln at a .uproject root, never here) — un-ignore them.
!bridge/*.sln
*.VC.db
*.VC.VC.opendb
*.opensdf
*.opendb
*.sdf
*.suo
*.user
*.xcodeproj
*.xcworkspace

# ----------------------------------------------------------------------------
# Sidecar bundle (#139/#187 Fab-surviving staging — the engine-canonical
# UnrealMCP/Source/ThirdParty/UnrealMcpBridge/<rid>/)
# The prebuilt self-contained bridge binaries (~73-80 MB/RID) are staged here
# transiently (release.yml signs+stages; Epic's Fab recompile stages from the
# submitted source) and are NEVER committed. Keep the folder STRUCTURE in VCS
# (README + per-RID .gitkeep) so the source zip ships the folders, but ignore
# every payload file inside them.
# ----------------------------------------------------------------------------
UnrealMCP/Source/ThirdParty/UnrealMcpBridge/**
!UnrealMCP/Source/ThirdParty/UnrealMcpBridge/
!UnrealMCP/Source/ThirdParty/UnrealMcpBridge/README.md
!UnrealMCP/Source/ThirdParty/UnrealMcpBridge/*/
!UnrealMCP/Source/ThirdParty/UnrealMcpBridge/*/.gitkeep

# ----------------------------------------------------------------------------
# .NET (bridge/)
# ----------------------------------------------------------------------------
bin/
obj/
publish/
TestResults/
# cli/bin holds the committed npm bin entry script — not a .NET build output.
!cli/bin/

# ----------------------------------------------------------------------------
# Node (cli/)
# ----------------------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo

# ----------------------------------------------------------------------------
# Secrets — NEVER commit. A project-root .env can hold UNREAL_MCP_TOKEN
# (see docs/ARCHITECTURE.md §8 — token commit hazard).
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example

# ----------------------------------------------------------------------------
# Python (scripts/ — e.g. window_smoke.py generates scripts/__pycache__/*.pyc)
# ----------------------------------------------------------------------------
__pycache__/
*.pyc

# ----------------------------------------------------------------------------
# Logs / OS / misc
# ----------------------------------------------------------------------------
logs/
*.log
.DS_Store
Thumbs.db

# Agent memory (infra workspace convention — never commit nested agent-memory dirs)
**/.claude/agent-memory/
**/.claude/pipeline/.runtime/