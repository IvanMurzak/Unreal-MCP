  "VersionName": "0.2.0",
  "FriendlyName": "Unreal AI PCG",
  "Description": "RQL module for Unreal's Procedural Content Generation (PCG) framework: author PCG graphs (node types with descriptions, templates, nodes, connections, settings, graph parameters), place them on PCG volumes, generate and read back instance counts. Procedural scattering of forests, rocks and props over landscapes, filtered by slope and height, avoiding splines. An AI Game Developer (Unreal-MCP) extension: an IUnrealMcpRqlModule that agents use through rql-query / rql-mutate / rql-schema.",
  "Category": "AI",
  "CreatedBy": "IvanMurzak/Unreal-AI-PCG",
  "CreatedByURL": "https://github.com/IvanMurzak/Unreal-AI-PCG",
  "DocsURL": "https://github.com/IvanMurzak/Unreal-MCP/blob/main/docs/EXTENSIONS.md",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/IvanMurzak/Unreal-MCP/issues",
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": false,
  "Installed": false,
  "Modules": [
    {
      "Name": "UnrealAIPCG",
      "Type": "Editor",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
